    "35":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: Click on a specific id field in the table below and select "Open with..." to view host details in the Infrastructure & Operations app.
      query: |
        // Fetch active hosts affected by disk space, high CPU, or high memory events in the last 6 hours and 10 minutes

        // Step 1: Load all HOST nodes from Smartscape
        smartscapeNodes HOST
        | filter matchesValue($PrimaryTag,"ALL") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array("")))
        | fieldsAdd isUnderMaintenance = id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ]
        | filter matchesValue($HostsUnderMaintenance, "Include") or not(isUnderMaintenance)
        | fieldsAdd `Maintenance window` = if(isUnderMaintenance, "Active", else: "-")
        | fields dt.smartscape.host = id, name, `Maintenance window`

        // Step 2: Lookup event counts per host from the events bucket
        | lookup
        [
          fetch events, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to), scanLimitGBytes: -1
          | filter in(dt.system.bucket, { "default_davis_events", "default_davis_custom_events", "default_k8s_ops_events" })
          | filter event.kind == "DAVIS_EVENT"
          | filter contains(toString(smartscape.affected_entity.ids), "HOST")
          | filter matchesPhrase(event.name, "CPU") or matchesPhrase(event.name, "Memory")
              or matchesPhrase(event.name, "Disk") or matchesPhrase(event.group_label, "Disk")
          | fieldsAdd eventType = if(matchesPhrase(event.name, "Disk") or matchesPhrase(event.group_label, "Disk"), "Disk", else:
              if(matchesPhrase(event.name, "Cpu"), "CPU", else: "Memory"))
          | sort timestamp
          // Deduplicate per event.id and keep relevant fields
          | summarize {
              event.start              = takeLast(event.start),
              event.end                = takeLast(event.end),
              event.status             = takeLast(event.status),
              dt.davis.is_duplicate    = takeLast(dt.davis.is_duplicate),
              affected_entities        = takeLast(smartscape.affected_entity.ids),
              related_entities         = takeLast(smartscape.related_entity.ids),
              eventType                = takeLast(eventType)
            }, by: { event.id }
          | filter isNull(dt.davis.is_duplicate) OR not(dt.davis.is_duplicate)
          | filter event.status == "ACTIVE"
          | filter isNull(event.end) OR event.end >= toTimestamp($dt_timeframe_from)
          | filter event.start <= toTimestamp($dt_timeframe_to)
          | expand host = affected_entities
          | filter contains(toString(host), "HOST-")
          // Summarize counts per event type for each host
          | summarize
              CPU_events    = sum(if(eventType == "CPU",    1, else: 0)),
              Memory_events = sum(if(eventType == "Memory", 1, else: 0)),
              Disk_events   = sum(if(eventType == "Disk",   1, else: 0))
            , by: { host }
        ], sourceField: dt.smartscape.host, lookupField: host, fields: { CPU_events, Memory_events, Disk_events }
        | filter (not(isNull(CPU_events)) or not(isNull(Memory_events)) or not(isNull(Disk_events)))

        // Step 3: Lookup latest average CPU, memory, and disk usage metrics per host
        | lookup
        [
          timeseries {
            CPU    = avg(dt.host.cpu.usage),
            Memory = avg(dt.host.memory.usage),
            Disk   = min(dt.host.disk.free)
          }, by: { dt.smartscape.host }, union: true
          | fields dt.smartscape.host,
                   CPU    = arrayLast(CPU),
                   Memory = arrayLast(Memory),
                   Disk   = 100 - arrayLast(Disk)
        ], sourceField: dt.smartscape.host, lookupField: dt.smartscape.host, fields: { CPU, Memory, Disk }

        // Step 4: Final output
        | fields
          Name              = name,
          id         = toString(dt.smartscape.host),
          CPU,
          `CPU events`      = if(isNull(CPU_events)    or CPU_events    == 0, "-", else: toLong(CPU_events)),
          Memory,
          `Memory events`   = if(isNull(Memory_events) or Memory_events == 0, "-", else: toLong(Memory_events)),
          Disk,
          `Disk events`     = if(isNull(Disk_events)   or Disk_events   == 0, "-", else: toLong(Disk_events)),
          `Maintenance window`
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Hosts reaching resource saturation (CPU, memory or disk)
      type: data
      visualization: table
      visualizationSettings:
        table:
          columnWidths:
            '["CPU events"]': 109
            '["CPU_warning"]': 134
            '["Disk_warning"]': 135
            '["Mem_warning"]': 140
            '["Name"]': 326
            '["avg_cpu"]': 109
            '["avg_disk"]': 105
            '["avg_mem"]': 112
            '["host.entity.name"]': 222.00000000000003
            '["host.id"]': 185
          hiddenColumns:
            - - dt.entity.host
            - - id
          hideColumnsForLargeResults: false
          sortBy:
            - columnId: '["Disk"]'
              direction: descending
    "38":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      query: |-
        // Aggregate distinct CPU / Memory / Disk events
        fetch events, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to)-2m, scanLimitGBytes:-1
        | filter in(dt.system.bucket, { "default_davis_events", "default_davis_custom_events", "default_k8s_ops_events"})
        | filter event.kind == "DAVIS_EVENT"
        | filter contains(toString(smartscape.affected_entity.ids), "HOST")
        | filter matchesValue($PrimaryTag,"ALL") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array("")))
        | filter matchesPhrase(event.name, "CPU") or matchesPhrase(event.name, "Memory") or matchesPhrase(event.name, "Disk") or matchesPhrase(event.group_label, "Disk")
        // assign eventType BEFORE dedupe
        | fieldsAdd eventType = if(matchesPhrase(event.name, "Disk") or matchesPhrase(event.group_label, "Disk"), "Disk", else:
            if(matchesPhrase(event.name, "Cpu"), "CPU", else: "Memory"))
        | sort timestamp
        // deduplicate per event.id and keep eventType (and other fields you need)
        | summarize {
            event.start = takeLast(event.start),
            event.end = takeLast(event.end),
            event.name = takeLast(event.name),
            event.category = takeLast(event.category),
            event.status = takeLast(event.status),
            event.description = takeLast(event.description),
            eventType = takeLast(eventType),
            dt.davis.is_duplicate = takeLast(dt.davis.is_duplicate),
            affected_entities = takeLast(smartscape.affected_entity.ids)
          }, by:{event.id}
        | filter isNull(dt.davis.is_duplicate) OR not(dt.davis.is_duplicate)
        | filter event.status == "ACTIVE"
        | filter isNull(event.end) OR event.end >= toTimestamp($dt_timeframe_from)
        | filter event.start <= toTimestamp($dt_timeframe_to)
        // filter events by maintenance window: exclude events only affecting MW hosts
        | expand host = affected_entities
        | filter startsWith(toString(host), "HOST-")
        | filter matchesValue($HostsUnderMaintenance, "Include") or not(host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])
        // now aggregate by eventType (use countDistinct since we expanded per host)
        | summarize event_count = countDistinct(event.id), by:{eventType}
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Events distribution by type
      type: data
      visualization: pieChart
      visualizationSettings:
        autoSelectVisualization: false
        chartSettings:
          legend:
            position: right
          truncationMode: middle
        legend:
          ratio: 46
