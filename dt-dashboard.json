urceField: smartscapeHost,\n  lookupField: id,\n  prefix: \"ss.\"\n\n| fields \n   host,\n   id = toString(ss.id),\n  `Smartscape Name` = ss.name,\n   Problems = problems\n| sort Problems desc\n\n| limit toLong($TopLimit)\n"
