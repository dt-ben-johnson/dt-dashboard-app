    "41":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: Counts hosts with problems that were reported inside of the choosen timeframe.
      query: "// Count hosts with active problems\nfetch events\n| filter matchesValue($PrimaryTag,\"ALL\") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array(\"\")))\n| filter event.kind == \"DAVIS_EVENT\"\n| filter timestamp >= toTimestamp($dt_timeframe_from)\n| filter timestamp <= toTimestamp($dt_timeframe_to)\n\n// filter in events related to host entity\n| filter contains(toString(smartscape.affected_entity.ids), \"HOST\") \n      or contains(toString(smartscape.related_entity.ids), \"HOST\")\n\n| summarize {\n  event.start = takeLast(event.start),\n  event.end = takeLast(event.end),\n  dt.davis.is_duplicate = takeLast(dt.davis.is_duplicate),\n  affected_entities = takeLast(smartscape.affected_entity.ids),\n  event.status = takeLast(event.status),\n  related_entities = takeLast(smartscape.related_entity.ids)\n},\nby: { event.id }\n\n// filter out duplicate events, filter in only active events\n| filter isNull(dt.davis.is_duplicate) or not(dt.davis.is_duplicate)\n| filter event.status == \"ACTIVE\"\n\n| filter isNull(event.end) or event.end >= toTimestamp($dt_timeframe_from)\n| filter event.start <= toTimestamp($dt_timeframe_to)\n\n// expand command will split <event, entity[]> into <event, entity>   \n// note: event may be affecting not just host entities, but disk, nic etc.\n| expand affectedEntity = affected_entities\n| expand related_entity = related_entities\n\n// filter out non-host entities\n| filter startsWith(toString(affectedEntity), \"HOST-\") or startsWith(toString(related_entity), \"HOST-\")\n| fieldsAdd host = if(startsWith(toString(affectedEntity), \"HOST-\"), affectedEntity, else: related_entity)\n| filter matchesValue($HostsUnderMaintenance, \"Include\") or not(host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])\n\n// arraySize of distinct events will count problems per host\n| summarize problems = arraySize(collectDistinct(event.id)),\n  by: { host }\n\n// hosts without problems are not counted\n| filter problems > 0\n\n// countDistinct will count records by skipping duplicates from field host\n| summarize hosts = countDistinct(host)\n"
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Hosts with problems
      type: data
      visualization: singleValue
      visualizationSettings:
        singleValue:
          colorThresholdTarget: background
          isIconVisible: true
          label: hosts
          labelMode: none
          prefixIcon: HostsIcon
          recordField: hosts
          trend:
            isVisible: false
        unitsOverrides:
          - added: 1.756111976142e+12
            baseUnit: count
            cascade: null
            decimals: 0
            delimiter: false
            displayUnit: null
            identifier: hosts
            suffix: ""
            unitCategory: unspecified
    "42":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: Average availability for all hosts. Only active hosts are counted in but the average of all is displayed. Availability is reported every couple of minutes, thus timeframe should include at least 5 minutes period.
      query: |
        // Calculate average host availability; maintenance windows count as uptime so planned maintenance does not lower availability
        smartscapeNodes HOST
        | filter matchesValue($PrimaryTag,"ALL") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array("")))
        | filter matchesValue($HostsUnderMaintenance, "Include") or not(id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])
        | lookup [
          timeseries {
            m1 = sum(dt.host.availability, rollup: sum, default: -1.0, filter: availability.state == "up"),
            mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance)
          }, by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to)-2m, union: true
          | fieldsAdd m1 = arraySlice(m1, from: 0, to: arraySize(m1) - 1)
          | fieldsAdd mw = arraySlice(mw, from: 0, to: arraySize(mw) - 1)
          | fieldsAdd intervalToMinutes = toLong(interval) / 60000000000
          | fieldsAdd effectiveUptime = if(mw[] > 0.0, toDouble(intervalToMinutes), else: if(m1[] > 0.0, if(m1[] > intervalToMinutes, toDouble(intervalToMinutes), else: m1[]), else: 0.0))
          | fieldsAdd hasDataOutsideMw = if(mw[] == 0.0 and m1[] >= 0.0, 1.0, else: 0.0)
          | fieldsAdd hasDataOutsideMw = arraySum(hasDataOutsideMw) > 0
          | fieldsAdd availability = if(hasDataOutsideMw, round((arraySum(effectiveUptime) / arraySize(effectiveUptime)) * 100 / intervalToMinutes, decimals: 2))
          | fields dt.smartscape.host, availability
        ], sourceField: id, lookupField: dt.smartscape.host, fields: { availability }
        | fields id, availability
        | summarize `avg(availability)` = coalesce(avg(availability), 0)
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Hosts availability
      type: data
      visualization: singleValue
      visualizationSettings:
        singleValue:
          colorThresholdTarget: background
          label: avg(availability)
          labelMode: none
          prefixIcon: HostsIcon
          recordField: avg(availability)
          trend:
            isVisible: false
        unitsOverrides:
          - added: 1.701249707791e+12
            baseUnit: percent
            cascade: null
            decimals: 2
            delimiter: false
            displayUnit: null
            identifier: avg(availability)
            suffix: ""
            unitCategory: percentage
