  settings: {}
  tiles:
    "0":
      content: "### Hosts health & performance \nGet broad visibility into key information, metrics and problems of hosts and infrastructure. For deeper analysis, please use the [Infrastructure & Operations](/ui/apps/dynatrace.infraops/smartscape/Hosts) app.\n\n"
      type: markdown
    "1":
      content: |
        ### Top used hosts
        Surface hosts consuming the most resources
      type: markdown
    "6":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: ""
      query: |-
        // Count monitored hosts, excluding monitoring candidates
        smartscapeNodes HOST
        | filterOut isMonitoringCandidate == true
        | filter matchesValue($PrimaryTag,"ALL") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array("")))
        | filter matchesValue($HostsUnderMaintenance, "Include") or not(id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])
        | summarize hosts = count()
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Total hosts
      type: data
      visualization: singleValue
      visualizationSettings:
        singleValue:
          isIconVisible: true
          label: hosts
          labelMode: none
          prefixIcon: HostsIcon
          recordField: hosts
          trend:
            isVisible: false
        unitsOverrides:
          - added: 1.75610772233e+12
            baseUnit: count
            cascade: null
            decimals: 0
            delimiter: false
            displayUnit: null
            identifier: hosts
            suffix: ""
            unitCategory: unspecified
    "9":
      content: |-
        ### Resource hotspots
        Identify the most resource-intensive hosts to address potential bottlenecks or optimize resource usage.
      type: markdown
    "10":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      query: |-
        // Scan limit is defined with the variable on top of the dashboard, changing it to -1 results in a unlimited scan size
        // In case the limit has been hit, the graph will only show data up until that point
        fetch logs, from: $dt_timeframe_from, samplingRatio: 100, scanLimitGBytes: toLong($ScanGBLimit)
        | filter matchesValue($PrimaryTag,"ALL") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array("")))
        | filter isNotNull(dt.smartscape.host)
        | filter matchesValue($HostsUnderMaintenance, "Include") or not(dt.smartscape.host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])
        | makeTimeseries logs = count(), by:{loglevel}
        | sort loglevel desc
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Logs accross all hosts
      type: data
      visualization: barChart
      visualizationSettings:
        autoSelectVisualization: false
        chartSettings:
          fieldMapping:
            leftAxisValues:
              - logs
            timestamp: timeframe
          leftYAxisSettings:
            label: dt.log.status_per_entity_count
          seriesOverrides:
            - override:
                color:
                  Default: 'var(--dt-colors-charts-loglevel-emergency-default, #ae132d)'
              seriesId:
                - ERROR
            - override:
                color:
                  Default: 'var(--dt-colors-charts-categorical-color-01-default, #134fc9)'
              seriesId:
                - INFO
            - override:
                color:
                  Default: 'var(--dt-colors-charts-categorical-color-02-default, #2c2f3f)'
              seriesId:
                - NONE
            - override:
                color:
                  Default: 'var(--dt-colors-charts-categorical-color-06-default, #a9780f)'
              seriesId:
                - WARN
          tooltip:
            variant: shared
          truncationMode: middle
          xAxisLabel: timeframe
          xAxisScaling: analyzedTimeframe
        coloring:
          colorRules:
            - colorMode: color-palette
              colorPalette: log-level
              comparator: = *value*
              field: DT.name
              type: string
              value: ""
            - colorMode: custom-color
              comparator: =
              customColor:
                Default: 'var(--dt-colors-charts-loglevel-emergency-default, #ae132d)'
              field: DT.name
              type: string
              value: ERROR
            - colorMode: custom-color
              comparator: =
              customColor:
                Default: 'var(--dt-colors-charts-categorical-color-01-default, #134fc9)'
              field: DT.name
              type: string
              value: INFO
            - colorMode: custom-color
              comparator: =
              customColor:
                Default: 'var(--dt-colors-charts-categorical-color-02-default, #2c2f3f)'
              field: DT.name
              type: string
              value: NONE
            - colorMode: custom-color
              comparator: =
              customColor:
                Default: 'var(--dt-colors-charts-categorical-color-06-default, #a9780f)'
              field: DT.name
              type: string
              value: WARN
        dataMapping:
          displayedFields:
            - loglevel
    "11":
      content: |
        ### Logs
      type: markdown
    "13":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: This chart is affected by the "TopLimit" variable.
      query: "// Retrieve top processes by average CPU usage, traverse to their host, and display both names.\ntimeseries cpuUsage = avg(dt.process.cpu.usage), by:{dt.smartscape.process},\n   filter: dt.smartscape.process in [\n     smartscapeNodes PROCESS\n     | traverse runs_on, HOST, direction: forward\n     | filter matchesValue($PrimaryTag,\"ALL\") \n         or arraySize(array($Values)) == 0 \n         or in($PrimaryTag:noquote, arrayConcat(array($Values), array(\"\")))\n     | filter matchesValue($HostsUnderMaintenance, \"Include\") or not(id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])\n     | fields processId = dt.traverse.history[0][id]\n     | fields id = processId\n   ]\n| sort arrayAvg(cpuUsage) desc\n| limit toLong($TopLimit)\n| fieldsAdd processName = getNodeName(dt.smartscape.process)\n| lookup [\n    smartscapeNodes PROCESS\n    | traverse runs_on, HOST, direction: forward, fieldsKeep: name\n    | fieldsAdd processId = dt.traverse.history[0][id], processName = dt.traverse.history[0][name]\n    | fields processId, hostName = name, hostId = id\n  ],\n  sourceField: dt.smartscape.process,\n  lookupField: processId,\n  prefix: \"host.\"\n\n| fieldsAdd isUnderMaintenance = host.hostId in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ]\n| fieldsAdd processName = if(isUnderMaintenance, concat(processName, \" (in maintenance)\"), else: processName)"
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Top $TopLimit processes by highest CPU
      type: data
      visualization: lineChart
      visualizationSettings:
        chartSettings:
          fieldMapping:
            leftAxisValues:
              - cpuUsage
            timestamp: timeframe
          gapPolicy: connect
          leftYAxisSettings:
            label: Process CPU usage
            max:
              mode: custom
              value: 100
          legend:
            position: right
          tooltip:
            variant: shared
          truncationMode: middle
          xAxisLabel: timeframe
          xAxisScaling: analyzedTimeframe
        dataMapping:
          displayedFields:
            - processName
        legend:
          ratio: 40
    "14":
      content: '### Technologies and processes'
      type: markdown
    "16":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: This chart is affected by the "TopLimit" variable.
      query: "// Retrieve the top hosts by average CPU usage, sort them in descending order.\n// Uses Smartscape HOST nodes to resolve readable host names natively.\ntimeseries t_cpu = avg(dt.host.cpu.usage), by: { dt.smartscape.host },\n   filter: dt.smartscape.host in [\n     smartscapeNodes HOST\n     | filter matchesValue($PrimaryTag,\"ALL\") \n         or arraySize(array($Values)) == 0 \n         or in($PrimaryTag:noquote, arrayConcat(array($Values), array(\"\")))\n     | fields id\n   ]\n| filter matchesValue($HostsUnderMaintenance, \"Include\") or not(dt.smartscape.host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])\n| sort arrayAvg(t_cpu) desc\n// limit number of results using variable\n| limit toLong($TopLimit)\n// Enrich with readable host name via Smartscape HOST node lookup\n| lookup [\n    smartscapeNodes HOST\n    | fields id, hostName = name\n  ],\n  sourceField: dt.smartscape.host,\n  lookupField: id,\n  fields: { hostName }\n\n| fieldsAdd isUnderMaintenance = dt.smartscape.host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ]\n| fieldsAdd hostName = if(isUnderMaintenance, concat(hostName, \" (in maintenance)\"), else: hostName)"
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Top $TopLimit hosts by highest CPU load
      type: data
      visualization: lineChart
      visualizationSettings:
        chartSettings:
          fieldMapping:
            leftAxisValues:
              - t_cpu
            timestamp: timeframe
          gapPolicy: connect
          leftYAxisSettings:
            label: CPU usage %
            max:
              mode: custom
              value: 100
          legend:
            position: right
          tooltip:
            variant: shared
          truncationMode: middle
          xAxisLabel: timeframe
          xAxisScaling: analyzedTimeframe
        dataMapping:
          displayedFields:
            - hostName
        legend:
          ratio: 39
    "17":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: This chart is affected by the "TopLimit" variable.
      query: "// Retrieve the top hosts by average memory usage, calculate the average memory for each host, sort them in descending order.\ntimeseries t_mem=avg(dt.host.memory.used), by:{dt.smartscape.host},\n   filter: dt.smartscape.host in [\n     smartscapeNodes HOST\n     | filter matchesValue($PrimaryTag,\"ALL\") \n         or arraySize(array($Values)) == 0 \n         or in($PrimaryTag:noquote, arrayConcat(array($Values), array(\"\")))\n     | fields id\n   ]\n| filter matchesValue($HostsUnderMaintenance, \"Include\") or not(dt.smartscape.host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])\n| fieldsAdd avg_mem=arrayAvg(t_mem)\n| sort avg_mem desc\n// limit number of results using variable\n| limit toLong($TopLimit)\n| lookup [\n    smartscapeNodes HOST\n    | fields id, hostName = name\n  ],\n  sourceField: dt.smartscape.host,\n  lookupField: id,\n  fields: { hostName }\n\n| fieldsAdd isUnderMaintenance = dt.smartscape.host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ]\n| fieldsAdd hostName = if(isUnderMaintenance, concat(hostName, \" (in maintenance)\"), else: hostName)"
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Top $TopLimit hosts by highest memory consumption
      type: data
      visualization: lineChart
      visualizationSettings:
        chartSettings:
          fieldMapping:
            leftAxisValues:
              - t_mem
            timestamp: timeframe
          gapPolicy: connect
          leftYAxisSettings:
            label: Memory used
          legend:
            position: right
          tooltip:
            variant: shared
          truncationMode: middle
          xAxisLabel: timeframe
          xAxisScaling: analyzedTimeframe
        dataMapping:
          displayedFields:
            - hostName
        legend:
          ratio: 40
        unitsOverrides:
          - added: 1.729690610327e+12
            baseUnit: byte
            cascade: null
            decimals: 0
            delimiter: false
            displayUnit: null
            identifier: t_mem
            suffix: ""
            unitCategory: data
    "18":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: This chart is affected by the "TopLimit" variable.
      query: "// Retrieve the top hosts by average disk usage, calculate the average disk usage for each host, sort them in descending order.\ntimeseries t_disk = min(dt.host.disk.free), by: { dt.smartscape.host },\n   filter: dt.smartscape.host in [\n     smartscapeNodes HOST\n     | filter matchesValue($PrimaryTag,\"ALL\") \n         or arraySize(array($Values)) == 0 \n         or in($PrimaryTag:noquote, arrayConcat(array($Values), array(\"\")))\n     | fields id\n   ]\n| filter matchesValue($HostsUnderMaintenance, \"Include\") or not(dt.smartscape.host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])\n| fieldsAdd t_disk   = 100 - t_disk[]\n| fieldsAdd avg_disk = arrayAvg(t_disk)\n| sort avg_disk desc\n// limit number of results using variable\n| lookup [\n    smartscapeNodes HOST\n    | fields id, hostName = name\n  ],\n  sourceField: dt.smartscape.host,\n  lookupField: id,\n  fields: { hostName }\n| filterOut isNull(hostName)\n| fieldsAdd isUnderMaintenance = dt.smartscape.host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ]\n| fieldsAdd hostName = if(isUnderMaintenance, concat(hostName, \" (in maintenance)\"), else: hostName)\n| limit toLong($TopLimit)\n| fields t_disk, timeframe, interval, hostName, dt.smartscape.host\n"
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Top $TopLimit hosts by highest disk usage
      type: data
      visualization: lineChart
      visualizationSettings:
        chartSettings:
          fieldMapping:
            leftAxisValues:
              - t_disk
            timestamp: timeframe
          gapPolicy: connect
          leftYAxisSettings:
            label: Disk usage
            min:
              mode: data-min
          legend:
            position: right
          tooltip:
            variant: shared
          truncationMode: middle
          xAxisLabel: timeframe
          xAxisScaling: analyzedTimeframe
        dataMapping:
          displayedFields:
            - hostName
        legend:
          ratio: 40
    "22":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: This chart is affected by the "TopLimit" variable.
      query: "// Retrieve the selected amount of hosts by highest total network traffic, sort them in descending order.\ntimeseries {\n  bytes_rx = avg(dt.host.net.nic.bytes_rx),\n  bytes_tx = avg(dt.host.net.nic.bytes_tx)\n}, by:{dt.smartscape.host},\n   filter: dt.smartscape.host in [\n     smartscapeNodes HOST\n     | filter matchesValue($PrimaryTag,\"ALL\") \n         or arraySize(array($Values)) == 0 \n         or in($PrimaryTag:noquote, arrayConcat(array($Values), array(\"\")))\n     | fields id\n   ]\n| filter matchesValue($HostsUnderMaintenance, \"Include\") or not(dt.smartscape.host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])\n\n// sum of bytes received and transmitted\n| fieldsAdd Bps = bytes_rx[]+bytes_tx[]\n\n| sort arraySum(Bps) desc\n\n// limit number of results using variable\n| limit toLong($TopLimit)\n| lookup [\n    smartscapeNodes HOST\n    | fields id, hostName = name\n  ],\n  sourceField: dt.smartscape.host,\n  lookupField: id,\n  fields: { hostName }\n| fieldsAdd isUnderMaintenance = dt.smartscape.host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ]\n| fieldsAdd hostName = if(isUnderMaintenance, concat(hostName, \" (in maintenance)\"), else: hostName)\n| fieldsRemove bytes_tx, bytes_rx, isUnderMaintenance\n"
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Top $TopLimit hosts by highest network traffic
      type: data
      visualization: lineChart
      visualizationSettings:
        chartSettings:
          fieldMapping:
            leftAxisValues:
              - Bps
            timestamp: timeframe
          gapPolicy: connect
          leftYAxisSettings:
            label: NIC bytes received • NIC bytes sent on host
          legend:
            position: right
          tooltip:
            variant: shared
          truncationMode: middle
          xAxisLabel: timeframe
          xAxisScaling: analyzedTimeframe
        dataMapping:
          displayedFields:
            - hostName
        legend:
          ratio: 40
        unitsOverrides:
          - added: 1.770739206749e+12
            baseUnit: Bps
            cascade: null
            decimals: null
            delimiter: false
            displayUnit: null
            identifier: Bps
            suffix: ""
            unitCategory: datarate
    "27":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      query: "// Calculate the average CPU usage percentage per cloud type.\nsmartscapeNodes HOST\n\n| filter matchesValue($PrimaryTag,\"ALL\") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array(\"\")))\n| filter matchesValue($HostsUnderMaintenance, \"Include\") or not(id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])\n// exclude hosts without cloud type\n| filterOut isNull(cloud.provider)\n\n// attach CPU consumption to hosts\n| lookup [\n  timeseries cpu = avg(dt.host.cpu.usage), by: { dt.smartscape.host }\n  | fieldsAdd lastCpu = arrayLast(cpu)\n], sourceField: id, lookupField: dt.smartscape.host, fields: { lastCpu }\n\n// summarize CPU usage per cloud type \n| summarize `Average CPU %` = avg(lastCpu), by: {`Cloud Type` = cloud.provider}\n\n| sort `Average CPU %` DESC\n\n"
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Average CPU for cloud types
      type: data
      visualization: table
      visualizationSettings:
        table:
          columnWidths:
            '["Hypervisor Type"]': 200
        unitsOverrides:
          - added: 1.77038487086e+12
            baseUnit: percent
            cascade: null
            decimals: null
            delimiter: false
            displayUnit: null
            identifier: Average CPU %
            suffix: ""
            unitCategory: percentage
    "32":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      query: "// Retrieve the total number of NIC bytes received and sent over time,\n// using summed rollups for accuracy, filtered to Smartscape host entities\ntimeseries {\n  `NIC bytes received` = sum(dt.host.net.nic.bytes_rx),\n  `NIC bytes sent` = sum(dt.host.net.nic.bytes_tx)\n}, filter: dt.smartscape.host in [\n    smartscapeNodes HOST\n    | filter matchesValue($PrimaryTag,\"ALL\") \n        or arraySize(array($Values)) == 0 \n        or in($PrimaryTag:noquote, arrayConcat(array($Values), array(\"\")))\n    | filter matchesValue($HostsUnderMaintenance, \"Include\") or not(id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])\n    | fields id\n  ]\n"
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: 'Hosts network traffic '
      type: data
      visualization: lineChart
      visualizationSettings:
        chartSettings:
          fieldMapping:
            leftAxisValues:
              - NIC bytes received
              - NIC bytes sent
            timestamp: timeframe
          gapPolicy: connect
          leftYAxisSettings:
            label: NIC bytes received • NIC bytes sent on host
          tooltip:
            variant: shared
          xAxisLabel: timeframe
          xAxisScaling: analyzedTimeframe
        unitsOverrides: []
    "33":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
