        enabled: false
      description: Calculated as sum of inbound and outbound traffic for all hosts within a dashboard timeframe.
      query: "// Calculate the total network traffic volume (bytes received and transmitted)\n// across hosts filtered by PrimaryTag using timeseries data.\ntimeseries {\n  bytes_rx = avg(dt.host.net.nic.bytes_rx), // bytes/s\n  bytes_tx = avg(dt.host.net.nic.bytes_tx)\n}, by: { dt.smartscape.host },\n   filter: dt.smartscape.host in [\n     smartscapeNodes HOST\n     | filter matchesValue($PrimaryTag,\"ALL\") \n         or arraySize(array($Values)) == 0 \n         or in($PrimaryTag:noquote, arrayConcat(array($Values), array(\"\")))\n     | fields id\n   ]\n| filter matchesValue($HostsUnderMaintenance, \"Include\") or not(dt.smartscape.host in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])\n// Convert the `interval` field from nanoseconds to seconds for accurate time-based calculation\n| fieldsAdd intervalToSeconds = toLong(interval) / power(10, 9)\n| fieldsAdd trafficVolume = (arraySum(bytes_rx) + arraySum(bytes_tx)) * intervalToSeconds\n| summarize sum(trafficVolume)\n"
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Total traffic
      type: data
      visualization: singleValue
      visualizationSettings:
        singleValue:
          label: traffic_gb
          labelMode: none
          prefixIcon: HostsIcon
          recordField: sum(trafficVolume)
          trend:
            isVisible: false
        unitsOverrides:
          - added: 1.70124974519e+12
            baseUnit: byte
            cascade: null
            decimals: 2
            delimiter: false
            displayUnit: null
            identifier: sum(trafficVolume)
            suffix: ""
            unitCategory: data
    "47":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: |-
        Click on honeycomb to see the name of the host tooltip and click in "Open with..." to view host details in the Infrastructure & Operations app.
        This chart is affected by the "TopLimit" variable.
      query: |
        // Rank hosts by lowest availability; maintenance windows count as uptime so planned maintenance does not lower availability
        smartscapeNodes HOST

        // Only keep hosts that are currently active
        | filter matchesValue($PrimaryTag,"ALL") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array("")))
        | filter matchesValue($HostsUnderMaintenance, "Include") or not(id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])
        | filter isNull(lifetime.end) or lifetime.end >= now()

        | lookup [
          timeseries {
            m1 = sum(dt.host.availability, rollup: sum, default: -1.0, filter: availability.state == "up"),
            mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance)
          }, by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) - 2m, union: true
          | fieldsAdd m1 = arraySlice(m1, from: 0, to: arraySize(m1) - 1)
          | fieldsAdd mw = arraySlice(mw, from: 0, to: arraySize(mw) - 1)
          | fieldsAdd intervalToMinutes = toLong(interval) / 60000000000
          | fieldsAdd effectiveUptime = if(mw[] > 0.0, toDouble(intervalToMinutes), else: if(m1[] > 0.0, if(m1[] > intervalToMinutes, toDouble(intervalToMinutes), else: m1[]), else: 0.0))
          | fieldsAdd hasDataOutsideMw = if(mw[] == 0.0 and m1[] >= 0.0, 1.0, else: 0.0)
          | fieldsAdd hasDataOutsideMw = arraySum(hasDataOutsideMw) > 0
          | fieldsAdd availability = if(hasDataOutsideMw, round((arraySum(effectiveUptime) / arraySize(effectiveUptime)) * 100 / intervalToMinutes, decimals: 2))
          | fields dt.smartscape.host, availability
        ], sourceField: id, lookupField: dt.smartscape.host, fields: { availability }

        | fields Name = name, id = toString(id), `Availability %` = availability
        | filterOut isNull(`Availability %`)

        | sort `Availability %` ASC
        | limit toLong($TopLimit)
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Top $TopLimit hosts by lowest availability
      type: data
      visualization: honeycomb
      visualizationSettings:
        coloring:
          colorRules:
            - colorMode: color-palette
              colorPalette: red-green-inverted
              comparator: = *value*
              field: ""
              type: string
              value: ""
        honeycomb:
          labels:
            showLabels: true
          max:
            mode: custom
            value: 100
          min:
            mode: custom
            value: 0
          truncationMode: middle
        unitsOverrides:
          - added: 1.77073543306e+12
            baseUnit: percent
            cascade: null
            decimals: 0
            delimiter: false
            displayUnit: null
            identifier: Availability %
            suffix: ""
            unitCategory: percentage
    "48":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      query: "// Retrieve timeseries data for average CPU, memory, and disk usage percentages\n// across all hosts using Smartscape entities (aggregated, not per-host)\ntimeseries {\n  `CPU usage` = avg(dt.host.cpu.usage),\n  `Memory usage` = avg(dt.host.memory.usage),\n  `Disk usage` = avg(dt.host.disk.free)\n}, filter: dt.smartscape.host in [\n    smartscapeNodes HOST\n    | filter matchesValue($PrimaryTag,\"ALL\") \n        or arraySize(array($Values)) == 0 \n        or in($PrimaryTag:noquote, arrayConcat(array($Values), array(\"\")))\n    | filter matchesValue($HostsUnderMaintenance, \"Include\") or not(id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])\n    | fields id\n  ],\n   union: true\n| fieldsAdd `Disk usage` = 100 - `Disk usage`[]\n\n"
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: 'Average resources usage '
      type: data
      visualization: lineChart
      visualizationSettings:
        chartSettings:
          fieldMapping:
            leftAxisValues:
              - CPU usage
              - Memory usage
              - Disk usage
            timestamp: timeframe
          gapPolicy: connect
          leftYAxisSettings:
            label: CPU usage % • Memory available % • Disk used %
            max:
              mode: custom
              value: 100
          tooltip:
            variant: shared
          xAxisLabel: timeframe
          xAxisScaling: analyzedTimeframe
        dataMapping:
          displayedFields:
            - Memory usage
            - Disk usage
            - CPU usage
    "49":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      query: |-
        smartscapeNodes HOST
        | filter matchesValue($PrimaryTag,"ALL") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array("")))
        | filter matchesValue($HostsUnderMaintenance, "Include") or not(id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])
        | filterOut isNull(hypervisor.type)
        | fieldsAdd hypervisorType = replaceString(hypervisor.type, "HYPERVISOR_TYPE_", "")
        | summarize count = count(), by: { hypervisorType }
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Hosts hypervisor type
      type: data
      visualization: pieChart
      visualizationSettings:
        autoSelectVisualization: false
        chartSettings:
          categoricalBarChartSettings:
            categoryAxis:
              - count
              - hypervisorType
              - hypervisor.type
            categoryAxisLabel: count,hypervisorType,hypervisor.type
          circleChartSettings:
            groupingThresholdType: relative
            valueType: relative
          truncationMode: middle
        legend:
          ratio: 58
    "50":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: ""
      query: |-
        // Count hosts by cloud provider, sort descending (Smartscape on Grail)
        smartscapeNodes HOST
        | filter matchesValue($PrimaryTag,"ALL") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array("")))
        | filter matchesValue($HostsUnderMaintenance, "Include") or not(id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])
        | filterOut isNull(cloud.provider)
        | fieldsAdd cloudType = cloud.provider
        | summarize count = count(), by: { cloudType }
        | sort count DESC
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Hosts cloud types
      type: data
      visualization: pieChart
      visualizationSettings:
        autoSelectVisualization: false
        chartSettings:
          categoricalBarChartSettings:
            categoryAxis:
              - cloudType
              - count
          circleChartSettings:
            groupingThresholdType: relative
            valueType: relative
          legend:
            position: right
          truncationMode: middle
        coloring:
          colorRules:
            - colorMode: color-palette
              colorPalette: categorical
              comparator: = *value*
              field: DT.name
              type: string
              value: ""
            - colorMode: custom-color
              comparator: =
              customColor:
                Default: 'var(--dt-colors-charts-categorical-color-01-default, #134fc9)'
              field: DT.name
              type: string
              value: AWS • 1239
            - colorMode: custom-color
              comparator: =
              customColor: '#b3007d'
              field: DT.name
              type: string
              value: AZURE • 306
            - colorMode: custom-color
              comparator: =
              customColor:
                Default: 'var(--dt-colors-charts-categorical-color-15-default, #9033a3)'
              field: DT.name
              type: string
              value: GOOGLE_CLOUD_PLATFORM • 301
            - colorMode: custom-color
              comparator: =
              customColor:
                Default: 'var(--dt-colors-charts-categorical-color-14-default, #d56b1a)'
              field: DT.name
              type: string
              value: VMWARE
            - colorMode: custom-color
              comparator: =
              customColor:
                Default: 'var(--dt-colors-charts-categorical-color-05-default, #84859a)'
              field: DT.name
              type: string
              value: UNKNOWN
        legend:
          ratio: 55
    "51":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      description: Click on a specific id field in the table below and select "Open with..." to view host details in the Infrastructure & Operations app.
      query: |
        // Identify the top 15 hosts with the highest CPU, memory, and disk usage
        // using Smartscape HOST nodes as the entity source.
        timeseries {
          CPU = avg(dt.host.cpu.usage)
        }, by: { dt.smartscape.host },
           filter: { matchesValue($PrimaryTag,"ALL") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array(""))) }
        | fieldsAdd CPU = arrayLast(CPU)
        | filterOut isNull(CPU)
        | sort CPU desc
        | limit 5

        | append [
          timeseries {
            Memory = avg(dt.host.memory.usage)
          }, by: { dt.smartscape.host },
             filter: { matchesValue($PrimaryTag,"ALL") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array(""))) }
          | fieldsAdd Memory = arrayLast(Memory)
          | filterOut isNull(Memory)
          | sort Memory desc
          | limit 5
        ]

        | append [
          timeseries {
            Disk = min(dt.host.disk.free)
          }, by: { dt.smartscape.host },
             filter: { matchesValue($PrimaryTag,"ALL") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array(""))) }
          | fieldsAdd Disk = 100 - arrayLast(Disk)
          | filterOut isNull(Disk)
          | sort Disk desc
          | limit 5
        ]

        | fields id = dt.smartscape.host
        | filter isNotNull(id)
        | dedup id

        | fieldsAdd isUnderMaintenance = id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ]
        | filter matchesValue($HostsUnderMaintenance, "Include") or not(isUnderMaintenance)
        | fieldsAdd `Maintenance window` = if(isUnderMaintenance, "Active", else: "-")

        // Enrich the selected top Smartscape HOST nodes with their latest
        // CPU, memory, and disk usage metrics via a timeseries lookup.
        | lookup [
          timeseries {
            CPU    = avg(dt.host.cpu.usage),
            Memory = avg(dt.host.memory.usage),
            Disk   = min(dt.host.disk.free)
          }, by: { dt.smartscape.host }, union: true
          | fields
              CPU    = arrayLast(CPU),
              Memory = arrayLast(Memory),
              Disk   = 100 - arrayLast(Disk),
              dt.smartscape.host
        ],
        sourceField: id,
        lookupField: dt.smartscape.host,
        fields: { CPU, Memory, Disk, dt.smartscape.host },
        executionOrder: leftFirst

        | fields Name = getNodeName(id),
                 CPU, Memory, Disk, `Maintenance window`, id = toString(id)
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Top 15 hosts by resource utilization (5 by CPU, 5 by memory, 5 by disk)
      type: data
      visualization: table
      visualizationSettings:
        table:
          columnWidths:
            '["CPU_warning"]': 134
            '["Disk"]': 85
            '["Disk_warning"]': 135
            '["Mem_warning"]': 140
            '["Memory"]': 94
            '["avg_cpu"]': 109
            '["avg_disk"]': 105
            '["avg_mem"]': 112
            '["entity.name"]': 315
            '["host.entity.name"]': 222.00000000000003
            '["host.id"]': 185
          hiddenColumns:
            - - dt.entity.host
            - - id
          hideColumnsForLargeResults: false
          sortBy:
            - columnId: '["Disk"]'
              direction: ascending
    "52":
      davis:
        davisVisualization:
          isAvailable: true
        enabled: false
      query: "// Calculate the average CPU usage for each hypervisor type, rename fields for better readability, and sort the results in descending order of average CPU usage\nsmartscapeNodes HOST\n\n| filter matchesValue($PrimaryTag,\"ALL\") or arraySize(array($Values)) == 0 or in($PrimaryTag:noquote, arrayConcat(array($Values), array(\"\")))\n| filter matchesValue($HostsUnderMaintenance, \"Include\") or not(id in [ timeseries mw = sum(dt.host.maintenance, default: 0, filter: maintenance.is_under_maintenance), by: { dt.smartscape.host }, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) | filter arrayMax(mw) > 0 | fields dt.smartscape.host ])\n// exclude hosts without hypervisor type\n| filterOut isNull(hypervisor.type)\n| fieldsAdd hypervisorType = replaceString(hypervisor.type, \"HYPERVISOR_TYPE_\", \"\")\n\n// attach CPU consumption metric to hosts\n| lookup [\n  timeseries cpu=avg(dt.host.cpu.usage), by: { dt.smartscape.host }\n  | fieldsAdd lastCpu = arrayLast(cpu)\n], sourceField: id, lookupField: dt.smartscape.host, fields: { lastCpu }\n\n// summarize CPU usage per hypervisor type \n| summarize averageCpuPerType = avg(lastCpu), by: { hypervisorType }\n\n| sort averageCpuPerType desc\n| fieldsRename `Hypervisor type` = hypervisorType\n| fieldsRename `Average CPU %` = averageCpuPerType\n"
      querySettings:
        defaultSamplingRatio: 10
        defaultScanLimitGbytes: 500
        enableSampling: false
        maxResultMegaBytes: 100
        maxResultRecords: 1000
      title: Average CPU for hypervisor types
      type: data
      visualization: table
      visualizationSettings:
        table:
          columnWidths:
            '["Hypervisor Type"]': 200
        unitsOverrides:
          - added: 1.77038487086e+12
            baseUnit: percent
            cascade: null
            decimals: null
            delimiter: false
            displayUnit: null
            identifier: Average CPU %
            suffix: ""
            unitCategory: percentage
  variables:
    - defaultValue: "5"
      editable: true
      input: "data \nrecord(limit = 1),\nrecord(limit = 5),\nrecord(limit = 10),\nrecord(limit = 50),\nrecord(limit = 100)"
      key: TopLimit
      multiple: false
      type: query
      version: 2
      visible: true
    - defaultValue: "500"
      editable: true
      key: ScanGBLimit
      type: text
      version: 2
      visible: true
    - defaultValue: Include
      editable: true
      input: data record(mode = "Include"), record(mode = "Exclude")
      key: HostsUnderMaintenance
      multiple: false
      type: query
      version: 2
      visible: true
    - editable: true
      input: "data record (name=\"ALL\")\n| append [fieldsSnapshot smartscape.nodes\n| filter startsWith(field, \"primary_tags.\") \n| fields field\n]"
      key: PrimaryTag
      multiple: false
      type: query
      version: 2
      visible: true
    - editable: true
      input: |-
        smartscapeNodes HOST
        | filter exists($PrimaryTag:noquote)
        | summarize prominence = count(), by: {$PrimaryTag:noquote}
        | sort prominence desc
        | fields $PrimaryTag:noquote
        | dedup $PrimaryTag:noquote
        | limit 1000
      key: Values
      multiple: true
      type: query
      version: 2
      visible: true
  version: 21
